{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "composite": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "#shared/*": ["./shared/*"] }
  },
  "include": ["api", "server", "shared", "scripts", "vite.config.ts"]
}
