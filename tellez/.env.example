# Copy to .env for local development. .env is gitignored; this file is not.
# In production these live in the Vercel project's environment settings.

# Neon Postgres. UNSET = the app falls back to a JSON file under .state/,
# which is what makes `npm run dev` work with no accounts and no setup.
# Never leave this unset in production: serverless instances do not share a
# filesystem, so progress would silently fragment across instances.
DATABASE_URL=

# Signs the session cookie. Any random 32+ characters.
# Unset falls back to a fixed development key — fine locally, useless in prod.
SESSION_SECRET=

# Gates /board. UNSET IN PRODUCTION MEANS THE BOARD IS CLOSED, deliberately.
# In development it falls back to "dev".
FACILITATOR_PASSWORD=
