# Copy to .env and fill in. .env is gitignored; this file is not.
#
# In production these go in Vercel: Project -> Settings -> Environment
# Variables. Nothing here may be committed with a real value, because
# NUSecurity/NUSEC is a public repository.
#
# If a flag variable is unset, that challenge answers "Challenge not found"
# rather than failing quietly, and its portal shows NUSEC{FLAG_NOT_CONFIGURED}.

FLAG_ADMIN_AUTHENTICATION=NUSEC{...}
FLAG_MEMBERS_ONLY=NUSEC{...}
FLAG_DISK_IMAGE_TRIAGE=NUSEC{...}
FLAG_LEAKED_LOGIN=NUSEC{...}
FLAG_PAPER_TRAIL=NUSEC{...}
FLAG_TICKET_TRIAGE=NUSEC{...}
FLAG_OPEN_BUCKET=NUSEC{...}
FLAG_SMART_LOCK=NUSEC{...}
FLAG_OBSCURE_ENCRYPTION=NUSEC{...}

# One letter per challenge, handed out as each is solved. Must be exactly as
# many letters as there are challenges (nine).
SECRET_WORD=...........

# The Members Only admin account. Leave unset and nobody can log in
# legitimately, which is fine — SQL injection is the intended route.
# Avoid $ in local values: dotenv expands $name even inside quotes, so a
# password containing one silently loads truncated. Vercel does not expand.
SQL_ADMIN_PASSWORD=
