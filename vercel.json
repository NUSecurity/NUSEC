{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/ctf/mini-ctf/admin",
      "destination": "/api/adminPortal"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
