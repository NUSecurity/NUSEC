{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "redirects": [
    {
      "source": "/tellez",
      "destination": "https://tellez.nusec.club",
      "permanent": false
    },
    {
      "source": "/tellez/:path*",
      "destination": "https://tellez.nusec.club/:path*",
      "permanent": false
    },
    {
      "source": "/tellez-incident",
      "destination": "https://tellez.nusec.club",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/ctf/hands-on-practice/admin",
      "destination": "/api/adminPortal"
    },
    {
      "source": "/ctf/hands-on-practice/image",
      "destination": "/api/diskImage"
    },
    {
      "source": "/ctf/hands-on-practice/login",
      "destination": "/api/sqlPortal"
    },
    {
      "source": "/ctf/hands-on-practice/social",
      "destination": "/api/osintProfiles"
    },
    {
      "source": "/ctf/hands-on-practice/triage",
      "destination": "/api/triageAssistant"
    },
    {
      "source": "/ctf/hands-on-practice/bucket",
      "destination": "/api/cloudBucket"
    },
    {
      "source": "/ctf/hands-on-practice/lock",
      "destination": "/api/smartLock"
    },
    {
      "source": "/ctf/hands-on-practice/lock-datasheet",
      "destination": "/api/lockDatasheet"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
